# Copy this file to .env and fill in real values BEFORE running docker compose.
# Never commit .env to version control.

DSPACE_VER=dspace-8.1
DOCKER_OWNER=dspace
DOCKER_REGISTRY=docker.io
COMPOSE_PROJECT_NAME=bulawayo-polytechnic-dspace-official

# Database password — generate a strong random value, e.g.:
#   openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
