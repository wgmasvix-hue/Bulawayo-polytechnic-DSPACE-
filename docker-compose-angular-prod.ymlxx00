services:
  dspace-angular:
    image: dspace/dspace-angular:dspace-8.1-dist
    container_name: dspace-angular
    restar    environment:
environment:
  DSPACE_UI_SSL: "true"
  DSPACE_UI_HOST: "bulawayo-polytechnic-repository.dare.co.zw"
  DSPACE_UI_PORT: "443"
  DSPACE_UI_NAMESPACE: "/"

  DSPACE_REST_SSL: "true"
  DSPACE_REST_HOST: "bulawayo-polytechnic-repository.dare.co.zw"
  DSPACE_REST_PORT: "443"
  DSPACE_REST_NAMESPACE: "/server"
    ports:
      - "4000:80"

    depends_on:
      - dspace

    networks:
      - dspacenet

networks:
  dspacenet:
    external: true
    name: bulawayo-polytechnic-dspace-official_dspacenet
