FROM dspace/dspace-angular:dspace-9.0-dist

# ── Bulawayo Polytechnic branding ──────────────────────────────────────────
# Replace the default DSpace navbar logo with the BPoly shield + wordmark.
# The dist image serves assets from /app/dist/browser/.

# Real PNGs (rasterized from the SVG sources in assets/) — browsers refuse
# SVG bytes served under a .png/.ico name, so the raster copies are what ship.
COPY assets/bpoly-logo.png /app/dist/browser/themes/dspace/assets/images/dspace-logo.png
COPY assets/bpoly-logo.png /app/dist/browser/assets/images/dspace-logo.png

# Replace the browser-tab favicon (PNG bytes are accepted at /favicon.ico).
COPY assets/favicon.png    /app/dist/browser/favicon.ico

# Also drop copies under the common asset paths used by older DSpace Angular builds.
COPY assets/bpoly-logo.png /app/dist/browser/themes/dspace/images/dspace-logo.png

# ── Institutional colour theme (ChengetAi) ─────────────────────────────────
# Ship the theme stylesheet and inject it into the SSR shell so every page
# loads it AFTER the compiled styles (institution colours win). The file is
# empty by default; `chengetai brand --primary ... --apply` fills it in. It is
# also bind-mounted at runtime by the campus stack, so colour-only changes
# don't need an image rebuild.
COPY assets/theme.css /app/dist/browser/assets/chengetai-theme.css
RUN sed -i 's#</head>#<link rel="stylesheet" href="/assets/chengetai-theme.css"></head>#' \
    /app/dist/browser/index.html
