FROM dspace/dspace-angular:dspace-8.1-dist

# ── Bulawayo Polytechnic branding ──────────────────────────────────────────
# Replace the default DSpace navbar logo with the BPoly shield + wordmark.
# The dist image serves assets from /app/dist/browser/.

COPY assets/bpoly-logo.svg /app/dist/browser/themes/dspace/assets/images/dspace-logo.png
COPY assets/bpoly-logo.svg /app/dist/browser/assets/images/dspace-logo.png

# Replace the browser-tab favicon.
COPY assets/favicon.svg    /app/dist/browser/favicon.ico

# Also drop copies under the common asset paths used by older DSpace Angular builds.
COPY assets/bpoly-logo.svg /app/dist/browser/themes/dspace/images/dspace-logo.png
